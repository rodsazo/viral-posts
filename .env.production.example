# =============================================================================
#  Plantilla de variables de entorno para PRODUCCIÓN (Laravel Cloud).
# =============================================================================
#  NO es un .env real: es la lista de variables a definir en el panel de
#  Laravel Cloud (Environment → Variables). Los valores con <...> los pones tú;
#  los marcados "(Cloud)" los inyecta automáticamente el servicio al adjuntar
#  la base de datos o el bucket de almacenamiento.
#  NUNCA comitees claves reales: este archivo solo lleva placeholders.
# =============================================================================

APP_NAME="Tracción Online"
APP_ENV=production
APP_KEY=                      # genera con: php artisan key:generate --show  (o lo crea Cloud)
APP_DEBUG=false
APP_URL=https://<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Seguridad de sesión / cookies (HTTPS) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

# --- Base de datos: MySQL gestionado (Cloud) ---
DB_CONNECTION=mysql
DB_HOST=                      # (Cloud) al adjuntar la base de datos
DB_PORT=3306                  # (Cloud)
DB_DATABASE=                  # (Cloud)
DB_USERNAME=                  # (Cloud)
DB_PASSWORD=                  # (Cloud)

# --- Colas y caché (driver database; el worker corre en Cloud) ---
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Almacenamiento ---
# Disco por defecto de la app (privado). Los LOGOS de marca van a S3 para que
# persistan entre deploys (el disco del contenedor es efímero).
FILESYSTEM_DISK=local
BRAND_FILESYSTEM_DISK=s3

# Object storage S3-compatible (Cloud lo provisiona y rellena estas variables).
AWS_ACCESS_KEY_ID=            # (Cloud)
AWS_SECRET_ACCESS_KEY=        # (Cloud)
AWS_DEFAULT_REGION=           # (Cloud)
AWS_BUCKET=                   # (Cloud)
AWS_URL=                      # (Cloud) URL pública del bucket (logos)
AWS_ENDPOINT=                 # (Cloud) si aplica
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Asistente de IA (Anthropic / Claude) ---
# Secreto: ponlo SOLO en el panel de Cloud, nunca en el repo. Rota si se expone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_LOG_DAYS=30

# --- FontAwesome 7 Pro (íconos de ganchos en el admin) ---
FONTAWESOME_URL=

# --- Estudio: revisión del cliente (aprobar/pedir cambios en la vista pública) ---
# Desactivada por defecto. Ponla en true cuando quieras habilitar la respuesta del cliente.
STUDIO_CLIENT_REVIEW=false

# --- Landing (home público) ---
# URL de agenda (Calendly/Cal.com) del botón principal + correo de contacto para el pie.
BOOKING_URL=https://cal.com/tu-usuario/estrategia
CONTACT_EMAIL=hola@traccion.online

# --- Backups off-site (spatie/laravel-backup) ---
# Bucket/proveedor SEPARADO del principal (verdadero off-site). El scheduler de Cloud
# corre backup:run a diario; avisa por correo solo si falla.
BACKUP_DISK=backups
BACKUP_NOTIFICATION_EMAIL=tu-correo@ejemplo.com
BACKUP_ARCHIVE_PASSWORD=            # opcional: cifra el zip del backup
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=               # p. ej. Backblaze B2 / otro S3-compatible
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Correo (invitaciones, notificaciones). Usa un proveedor real, no "log". ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@<tu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Logs ---
LOG_CHANNEL=stack
LOG_LEVEL=error
